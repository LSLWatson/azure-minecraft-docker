@description('Normalized Bedrock instance configuration.')
param config object
@description('Azure region.')
param location string
@description('Environment label.')
param environment string
@description('World storage account name.')
param storageAccountName string
@description('User-assigned container identity ID.')
param identityId string
@description('Log Analytics workspace name.')
param workspaceName string
@description('Application Insights component name.')
param insightsName string
@description('Alert action group ID.')
param actionGroupId string
@description('Linux Consumption Functions plan ID.')
param functionPlanId string
@description('Gamertag:XUID allowlist entries.')
param minecraftUsers string[]
@description('Operator XUIDs.')
param minecraftOps string[]
@description('Member XUIDs.')
param minecraftMembers string[]
@description('IANA container timezone.')
param minecraftTimezone string
@description('Enable managed-identity start/stop schedules.')
param enableAutoStartStop bool
@description('Custom narrowly scoped scheduling role definition ID.')
param schedulerRoleId string
@description('Windows schedule timezone.')
param timezone string
@description('Existing Azure DNS zone ID, or empty.')
param vanityDnsZoneId string
@description('Resource tags.')
param tags object

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' existing = { name: storageAccountName }
resource workspace 'Microsoft.OperationalInsights/workspaces@2023-09-01' existing = { name: workspaceName }
resource insights 'Microsoft.Insights/components@2020-02-02' existing = { name: insightsName }
var allowedUsers = config.allowOpsOnly ? filter(minecraftUsers, user => contains(minecraftOps, split(user, ':')[1])) : minecraftUsers
var environmentVariables = union({
  EULA: 'TRUE'
  VERSION: 'LATEST'
  SERVER_NAME: 'Minecraft Bedrock on Azure Container Instances'
  GAMEMODE: 'creative'
  DIFFICULTY: 'easy'
  ALLOW_CHEATS: 'false'
  ONLINE_MODE: 'true'
  ENABLE_LAN_VISIBILITY: 'false'
}, config.environmentVariables, {
  OPS: join(minecraftOps, ',')
  MEMBERS: join(minecraftMembers, ',')
  ALLOW_LIST: string(config.allowListEnabled || config.allowOpsOnly)
  ALLOW_LIST_USERS: join(allowedUsers, ',')
  TZ: minecraftTimezone
  MAX_PLAYERS: string(config.maxPlayers)
  TRANSPORT: 'nethernet'
  SERVER_PORT: string(config.serverPort)
  SERVER_PUBLIC_HOSTNAME: '${config.dnsNameLabel}.${replace(toLower(location), ' ', '')}.azurecontainer.io'
  SERVER_UDP_PORT_START: string(config.udpPortStart)
  SERVER_UDP_PORT_END: string(config.udpPortStart + config.maxPlayers - 1)
})
var udpPorts = [for port in range(config.udpPortStart, config.maxPlayers): { port: port, protocol: 'UDP' }]
var ports = concat([{ port: config.serverPort, protocol: 'TCP' }], udpPorts)
var instanceTags = union(tags, { 'configuration-name': config.name })
resource container 'Microsoft.ContainerInstance/containerGroups@2023-05-01' = {
  name: config.containerName
  location: location
  tags: instanceTags
  identity: { type: 'UserAssigned', userAssignedIdentities: { '${identityId}': {} } }
  properties: {
    osType: 'Linux'
    restartPolicy: 'Always'
    containers: [{
      name: 'minecraft'
      properties: {
        image: empty(config.imageTag) ? config.image : '${config.image}:${config.imageTag}'
        command: ['/bin/bash', '-c', loadTextContent('../assets/entrypoint.sh')]
        environmentVariables: [for item in items(environmentVariables): { name: item.key, value: string(item.value) }]
        resources: { requests: { cpu: 1, memoryInGB: 2 } }
        ports: ports
        livenessProbe: {
          httpGet: { path: '/v1/join', port: config.serverPort, scheme: 'http' }
          initialDelaySeconds: 300
          periodSeconds: 30
          timeoutSeconds: 10
          failureThreshold: 3
          successThreshold: 1
        }
        volumeMounts: [{ name: 'data', mountPath: '/data', readOnly: false }]
      }
    }]
    ipAddress: { type: 'Public', dnsNameLabel: config.dnsNameLabel, autoGeneratedDomainNameLabelScope: 'Unsecure', ports: ports }
    volumes: [{
      name: 'data'
      azureFile: { shareName: config.dataShareName, storageAccountName: storage.name, storageAccountKey: storage.listKeys().keys[0].value, readOnly: false }
    }]
    diagnostics: {
      logAnalytics: { workspaceId: workspace.properties.customerId, workspaceKey: workspace.listKeys().primarySharedKey, logType: 'ContainerInstanceLogs' }
    }
  }
}

module dns './dns.bicep' = if (!empty(vanityDnsZoneId)) {
  name: 'dns-${config.name}'
  scope: resourceGroup(split(vanityDnsZoneId, '/')[2], split(vanityDnsZoneId, '/')[4])
  params: {
    zoneName: last(split(vanityDnsZoneId, '/'))
    recordName: '${config.vanityHostnamePrefix}${environment == 'prod' ? '' : environment}'
    target: container.properties.ipAddress.fqdn
    tags: instanceTags
  }
}
var fqdn = empty(vanityDnsZoneId) ? container.properties.ipAddress.fqdn : '${config.vanityHostnamePrefix}${environment == 'prod' ? '' : environment}.${last(split(vanityDnsZoneId, '/'))}'
module functionApp './function.bicep' = {
  name: 'function-${config.name}'
  params: {
    name: config.functionName
    storageName: config.functionStorageAccountName
    createStorage: config.createFunctionStorageAccount
    adoptFunction: config.adoptFunction
    location: location
    planId: functionPlanId
    insightsName: insights.name
    workspaceName: workspace.name
    host: fqdn
    port: config.serverPort
    tags: instanceTags
  }
}
module schedules './schedule.bicep' = [for operation in ['start', 'stop']: if (enableAutoStartStop && (!empty(config['${operation}Time']) || !empty(config['${operation}TimeWeekend']))) {
  name: '${operation}-${config.name}'
  params: {
    name: '${config.containerName}-${operation}'
    containerName: container.name
    operation: operation
    weekdayTime: config['${operation}Time']
    weekendTime: config['${operation}TimeWeekend']
    timezone: timezone
    location: location
    workspaceName: workspace.name
    roleId: schedulerRoleId
    tags: instanceTags
  }
}]
resource inaccessible 'Microsoft.Insights/scheduledQueryRules@2023-12-01' = {
  name: '${resourceGroup().name}-${config.name}-inaccessible-alert'
  location: location
  tags: instanceTags
  properties: {
    enabled: true
    severity: 1
    scopes: [workspace.id]
    evaluationFrequency: 'PT5M'
    windowSize: 'PT5M'
    overrideQueryTimeRange: 'P2D'
    skipQueryValidation: true
    criteria: { allOf: [{
      query: replace(replace(loadTextContent('../../kusto/container-inaccessible.csl'), '\${container_group_name}', container.name), '\${function_name}', functionApp.outputs.name)
      timeAggregation: 'Count'
      operator: 'GreaterThan'
      threshold: 2
    }] }
    actions: { actionGroups: [actionGroupId] }
  }
}
resource metrics 'Microsoft.Insights/metricAlerts@2018-03-01' = [for alert in [
  { name: 'memory', metric: 'MemoryUsage', dynamic: false }
  { name: 'memory-dynamic', metric: 'MemoryUsage', dynamic: true }
  { name: 'cpu-dynamic', metric: 'CpuUsage', dynamic: true }
]: {
  name: '${config.containerName}-${alert.name}-alert'
  location: 'global'
  tags: instanceTags
  properties: {
    enabled: true
    severity: 3
    scopes: [container.id]
    evaluationFrequency: 'PT5M'
    windowSize: 'PT15M'
    targetResourceType: 'Microsoft.ContainerInstance/containerGroups'
    targetResourceRegion: location
    criteria: {
      'odata.type': 'Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria'
      allOf: [union({
        name: alert.name
        metricNamespace: 'Microsoft.ContainerInstance/containerGroups'
        metricName: alert.metric
        timeAggregation: 'Average'
        operator: 'GreaterThan'
        dimensions: [{ name: 'containerName', operator: 'Include', values: ['minecraft'] }]
      }, alert.dynamic ? {
        criterionType: 'DynamicThresholdCriterion'
        alertSensitivity: 'Low'
        failingPeriods: { numberOfEvaluationPeriods: 4, minFailingPeriodsToAlert: 3 }
      } : { criterionType: 'StaticThresholdCriterion', threshold: 1900000000 })]
    }
    actions: [{ actionGroupId: actionGroupId }]
  }
}]
output details object = {
  container_group_name: container.name
  container_group_id: container.id
  container_data_share_name: config.dataShareName
  minecraft_server_fqdn: fqdn
  minecraft_server_ip: container.properties.ipAddress.ip
  minecraft_server_port: config.serverPort
  minecraft_server_udp_ports: range(config.udpPortStart, config.maxPlayers)
  minecraft_server_connection: '${fqdn}:${config.serverPort}'
  function_name: functionApp.outputs.name
}
var scheduleIds = [for operation in ['start', 'stop']: {
  id: resourceId('Microsoft.Logic/workflows', '${config.containerName}-${operation}')
  enabled: !empty(config['${operation}Time']) || !empty(config['${operation}TimeWeekend'])
}]
output scheduleIds array = enableAutoStartStop ? scheduleIds : []
