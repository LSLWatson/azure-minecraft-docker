ContainerInstanceLog_CL
| where TimeGenerated > ago(365d)
| where Message contains "Player connected:"
| extend PlayerName=extract(@"Player connected: (.*?), xuid:", 1, Message)
| extend XUID=extract(@"xuid: ([0-9]+)", 1, Message)
| where isnotempty(PlayerName) and isnotempty(XUID)
| distinct XUID, PlayerName
| order by PlayerName
